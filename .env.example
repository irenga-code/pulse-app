VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: host the Twemoji pictures yourself instead of using the jsDelivr CDN (copy assets/svg from github.com/jdecked/twemoji, tag v15.1.0)
# VITE_TWEMOJI_BASE=/twemoji/

# Optional: a TURN server for calls (needed on many mobile networks and strict NATs; STUN alone is used otherwise).
# Comma-separate several URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_URLS=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
